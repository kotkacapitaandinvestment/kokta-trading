generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  trader
  premium
  admin
  super_admin
}

enum UserStatus {
  active
  suspended
  banned
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  initials     String
  role         Role       @default(trader)
  plan         String     @default("Free")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  lastLoginAt  DateTime?

  journalEntries   JournalEntry[]
  checklistDays    ChecklistDay[]
  settings         UserSettings?
  aiUsageLogs      AIUsageLog[]
  simulatorSessions SimulatorSession[]
}

model JournalEntry {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              String
  market            String
  session           String
  strategy          String
  direction         String
  entry             Float
  stopLoss          Float
  takeProfit        Float
  risk              Float
  reward            Float
  result            String?
  pnl               Float?
  emotionBefore     String
  emotionAfter      String?
  confidence        Int
  mistakes          String   @default("")
  lessons           String   @default("")
  checklistComplete Boolean  @default(false)
  positionStatus    String   @default("closed")
  closedAt          DateTime?
  createdAt         DateTime @default(now())

  @@index([userId])
}

model ChecklistDay {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String
  items  Json   @default("{}")

  @@unique([userId, date])
}

model UserSettings {
  id                String @id @default(cuid())
  userId            String @unique
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications     Json   @default("{\"checklist\": true, \"journal\": true, \"riskWarnings\": true, \"weeklyReview\": true, \"aiInsights\": false}")
  aiPreferences     Json   @default("{\"tone\": \"Direct & challenging\", \"autoSuggest\": true, \"rememberContext\": true}")
  tradingPreferences Json  @default("{\"baseCurrency\": \"USD\", \"dailyLossLimit\": 2, \"defaultRisk\": 1}")
}

model Integration {
  id           String   @id @default(cuid())
  provider     String   @unique
  secretCipher String?
  publicKey    String?
  config       Json     @default("{}")
  enabled      Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model ContentItem {
  id        String   @id @default(cuid())
  title     String
  type      String
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id        String   @id @default(cuid())
  title     String
  lessons   Int      @default(0)
  enrolled  Int      @default(0)
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  audience    String    @default("All users")
  status      String    @default("draft")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model MarketNewsItem {
  id          String   @id @default(cuid())
  headline    String
  market      String
  impact      String   @default("medium")
  publishedAt DateTime @default(now())
}

model AIUsageLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source     String
  model      String
  latencyMs  Int
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model SimulatorSession {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol              String
  ticker              String
  timeframeMultiplier Int
  timeframeUnit       String
  windowStart         DateTime
  windowEnd           DateTime
  bars                Json
  cursor              Int       @default(0)
  startingBalance     Float     @default(10000)
  balance             Float
  status              String    @default("active")
  createdAt           DateTime  @default(now())
  completedAt         DateTime?

  trades SimulatorTrade[]

  @@index([userId])
  @@index([createdAt])
}

model SimulatorTrade {
  id            String           @id @default(cuid())
  sessionId     String
  session       SimulatorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  direction     String
  size          Float
  entryPrice    Float
  entryBarIndex Int
  entryAt       DateTime
  stopLoss      Float?
  takeProfit    Float?
  exitPrice     Float?
  exitBarIndex  Int?
  exitAt        DateTime?
  pnl           Float?
  result        String?
  closeReason   String?
  status        String   @default("open")
  createdAt     DateTime @default(now())

  @@index([sessionId])
}
