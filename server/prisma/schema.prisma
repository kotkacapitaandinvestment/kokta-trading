generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  trader
  premium
  moderator
  admin
  super_admin
}

enum UserStatus {
  active
  suspended
  banned
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  initials     String
  role         Role       @default(trader)
  plan         String     @default("Free")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  lastLoginAt  DateTime?

  journalEntries    JournalEntry[]
  checklistDays     ChecklistDay[]
  settings          UserSettings?
  aiUsageLogs       AIUsageLog[]
  simulatorSessions SimulatorSession[]
  aiConversations   AIConversation[]
  kyc               KycProfile?

  // Community profile. username is chosen on first visit to Community.
  username            String?   @unique
  headline            String?
  bio                 String?
  avatarId            String?
  lastSeenAt          DateTime?
  communityMutedUntil DateTime?

  media               Media[]
  memberships         ConversationMember[]
  messages            Message[]
  messageReactions    MessageReaction[]
  posts               Post[]
  comments            Comment[]
  postReactions       PostReaction[]
  pollVotes           PollVote[]
  sentimentVotes      SentimentVote[]
  follows             Follow[]
  savedItems          SavedItem[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  reports             Report[]
  relations           UserRelation[] @relation("relationOwner")
  relatedBy           UserRelation[] @relation("relationTarget")

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_name_trgm")
}

model JournalEntry {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              String
  market            String
  session           String
  strategy          String
  direction         String
  entry             Float
  stopLoss          Float
  takeProfit        Float
  risk              Float
  reward            Float
  result            String?
  pnl               Float?
  emotionBefore     String
  emotionAfter      String?
  confidence        Int
  mistakes          String   @default("")
  lessons           String   @default("")
  checklistComplete Boolean  @default(false)
  positionStatus    String   @default("closed")
  closedAt          DateTime?
  createdAt         DateTime @default(now())
  // Kotka AI review, generated on request and kept with the entry.
  aiReview          String?
  aiReviewModel     String?
  aiReviewAt        DateTime?

  @@index([userId])
}

model ChecklistDay {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String
  items  Json   @default("{}")

  @@unique([userId, date])
}

model UserSettings {
  id                String @id @default(cuid())
  userId            String @unique
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications     Json   @default("{\"checklist\": true, \"journal\": true, \"riskWarnings\": true, \"weeklyReview\": true, \"aiInsights\": false}")
  aiPreferences     Json   @default("{\"tone\": \"Direct & challenging\", \"autoSuggest\": true, \"rememberContext\": true}")
  tradingPreferences Json  @default("{\"baseCurrency\": \"USD\", \"dailyLossLimit\": 2, \"defaultRisk\": 1}")
  // Community notification switches and privacy (online status, read
  // receipts, who may message you). Missing keys use the defaults in code.
  communityPreferences Json @default("{}")
}

model Integration {
  id           String   @id @default(cuid())
  provider     String   @unique
  secretCipher String?
  publicKey    String?
  config       Json     @default("{}")
  enabled      Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model ContentItem {
  id        String   @id @default(cuid())
  title     String
  type      String
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id        String   @id @default(cuid())
  title     String
  lessons   Int      @default(0)
  enrolled  Int      @default(0)
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String?
  audience    String    @default("All users")
  status      String    @default("draft")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model MarketNewsItem {
  id          String   @id @default(cuid())
  headline    String
  market      String
  impact      String   @default("medium")
  publishedAt DateTime @default(now())
}

model AIUsageLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source     String
  model      String
  latencyMs  Int
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Legacy: the Simulator feature was removed on 2026-09-26. These tables and
// their data are intentionally kept (owner's decision) — do not drop them.
model SimulatorSession {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol              String
  ticker              String
  timeframeMultiplier Int
  timeframeUnit       String
  windowStart         DateTime
  windowEnd           DateTime
  bars                Json
  cursor              Int       @default(0)
  startingBalance     Float     @default(10000)
  balance             Float
  status              String    @default("active")
  createdAt           DateTime  @default(now())
  completedAt         DateTime?

  trades SimulatorTrade[]

  @@index([userId])
  @@index([createdAt])
}

model SimulatorTrade {
  id            String           @id @default(cuid())
  sessionId     String
  session       SimulatorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  direction     String
  size          Float
  entryPrice    Float
  entryBarIndex Int
  entryAt       DateTime
  stopLoss      Float?
  takeProfit    Float?
  exitPrice     Float?
  exitBarIndex  Int?
  exitAt        DateTime?
  pnl           Float?
  result        String?
  closeReason   String?
  status        String   @default("open")
  createdAt     DateTime @default(now())

  @@index([sessionId])
}

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @default("New analysis")
  market    String      @default("Forex")
  favorite  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AIMessage[]

  @@index([userId])
  @@index([updatedAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  image          String?
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

// ── Kotka Fundamental Research ────────────────────────────────────────────
// Admin-controlled configuration (singleton row, id = "singleton").
model ResearchSettings {
  id        String   @id @default("singleton")
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Raw upstream responses (IMF, ECB, FRED, BIS, calendars...) cached server-side
// so repeated research runs don't re-hit every source.
model ResearchSourceCache {
  key       String   @id
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// Every completed research report is kept — the history is the fundamental trend.
model ResearchReport {
  id              String   @id @default(cuid())
  kind            String // "currency" | "pair"
  subject         String // "EUR" | "EURUSD"
  score           Int?
  confidence      Int?
  condition       String?
  direction       String?
  payload         Json
  narrativeSource String   @default("rules") // "rules" | "ai"
  model           String?
  durationMs      Int?
  createdAt       DateTime @default(now())

  @@index([kind, subject, createdAt])
}

model ResearchRun {
  id           String    @id @default(cuid())
  kind         String
  subject      String
  trigger      String // "user" | "admin" | "cron"
  userId       String?
  status       String    @default("running") // running | succeeded | failed
  error        String?
  sourceStatus Json      @default("[]")
  reportId     String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([subject, startedAt])
  @@index([userId, startedAt])
}

// Institutional assessments with no machine-readable API (e.g. IMF External
// Sector Report valuations), entered by an admin with the original source.
model SourceAssessment {
  id             String   @id @default(cuid())
  currency       String
  factor         String
  institution    String
  title          String
  classification String?
  statement      String
  url            String
  publishedAt    DateTime
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([currency, factor])
}

// ── Platform ──────────────────────────────────────────────────────────────
// Platform-wide switches (paid plans, sign-ups, KYC, AI fair use). Singleton.
model AppSettings {
  id        String   @id @default("singleton")
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Identity verification. Personal details are stored AES-256-GCM encrypted
// (detailsCipher); only country and review state are kept in the clear.
model KycProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  detailsCipher String
  country       String
  status        String    @default("pending") // pending | approved | rejected
  reviewNote    String?
  reviewedById  String?
  reviewedAt    DateTime?
  submittedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, submittedAt])
}

// Record of administrative and security-relevant actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  detail     Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}

// Sign-in / sign-up attempts, used for rate limiting.
model AuthAttempt {
  id        String   @id @default(cuid())
  kind      String // login | signup
  email     String?
  ip        String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([kind, email, createdAt])
  @@index([kind, ip, createdAt])
}

// ══ Community ═══════════════════════════════════════════════════════════════

// Uploaded images and voice notes. Kept in Postgres (no file store is set up);
// clients compress before upload. Served only to signed-in users, by id+token.
model Media {
  id         String   @id @default(cuid())
  token      String
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind       String // image | audio
  mime       String
  size       Int
  width      Int?
  height     Int?
  durationMs Int?
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([ownerId, createdAt])
}

// One model for every place people talk: direct messages, private groups,
// public/private communities, market rooms and event rooms.
model Conversation {
  id            String    @id @default(cuid())
  kind          String // dm | group | community | room | event
  visibility    String    @default("private") // public | private | invite_only
  slug          String?   @unique
  name          String?
  description   String?
  imageId       String?
  instrument    String? // market rooms
  eventId       String?   @unique
  event         MarketEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sendPolicy    String    @default("everyone") // everyone | admins
  joinPolicy    String    @default("open") // open | approval | invite
  inviteCode    String?   @unique
  dmKey         String?   @unique // "<userA>:<userB>" sorted, for one-to-one chats
  createdById   String?
  featured      Boolean   @default(false)
  archivedAt    DateTime?
  lastMessageAt DateTime?
  messageCount  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([kind, lastMessageAt])
  @@index([instrument])
}

model ConversationMember {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            String       @default("member") // owner | admin | moderator | member
  status          String       @default("active") // active | pending | left | removed
  mutedUntil      DateTime?
  archivedAt      DateTime?
  lastReadAt      DateTime?
  lastDeliveredAt DateTime?
  joinedAt        DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, status])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind           String       @default("text") // text | system
  body           String       @default("")
  // [{ type: image|audio|market|idea|post|news|event|poll, ... }]
  attachments    Json         @default("[]")
  mentions       String[]
  flags          String[] // safety flags raised when the message was sent
  replyToId      String?
  replyTo        Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReply")
  threadRootId   String?
  threadCount    Int          @default(0)
  lastThreadAt   DateTime?
  editedAt       DateTime?
  deletedAt      DateTime?
  removedById    String?
  pinnedAt       DateTime?
  pinnedById     String?
  createdAt      DateTime     @default(now())

  reactions MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([threadRootId, createdAt])
  @@index([authorId, createdAt])
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "Message_body_trgm")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

model Post {
  id            String    @id @default(cuid())
  authorId      String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind          String // post | market | idea | poll | question | news
  body          String    @default("")
  instrument    String?
  topics        String[]
  attachments   Json      @default("[]")
  newsId        String?
  news          NewsItem? @relation(fields: [newsId], references: [id], onDelete: SetNull)
  mentions      String[]
  flags         String[]
  commentCount  Int       @default(0)
  reactionCount Int       @default(0)
  featuredAt    DateTime?
  editedAt      DateTime?
  deletedAt     DateTime?
  removedById   String?
  removedAt     DateTime?
  createdAt     DateTime  @default(now())

  idea      TradeIdea?
  poll      Poll?
  reactions PostReaction[]

  @@index([createdAt])
  @@index([instrument, createdAt])
  @@index([authorId, createdAt])
  @@index([kind, createdAt])
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "Post_body_trgm")
}

// Structured market thesis. Never called a signal.
model TradeIdea {
  id              String    @id @default(cuid())
  postId          String    @unique
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  instrument      String
  direction       String // bullish | bearish
  timeframe       String
  entry           Float
  stop            Float
  target          Float
  riskReward      Float?
  thesis          String
  status          String    @default("open") // open | updated | closed | invalidated
  statusNote      String?
  statusChangedAt DateTime?
  history         Json      @default("[]")
  createdAt       DateTime  @default(now())

  @@index([instrument, status])
}

// Comments on posts, trade ideas and news items. A comment with a
// challengeCategory is a structured "Challenge thesis".
model Comment {
  id                String    @id @default(cuid())
  targetType        String // post | news
  targetId          String
  authorId          String
  author            User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId          String?
  body              String
  challengeCategory String? // technical | fundamental | risk | timing | liquidity | invalidation
  mentions          String[]
  flags             String[]
  editedAt          DateTime?
  deletedAt         DateTime?
  removedById       String?
  createdAt         DateTime  @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([authorId, createdAt])
}

model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String   @default("like")
  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
}

// A poll belongs to a post or to a chat message.
model Poll {
  id        String       @id @default(cuid())
  postId    String?      @unique
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  messageId String?      @unique
  question  String
  closesAt  DateTime?
  createdAt DateTime     @default(now())
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label     String
  position  Int
  voteCount Int        @default(0)
  votes     PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([pollId, userId])
}

// Each trader's current view on an instrument; changeable any time.
model SentimentVote {
  id         String   @id @default(cuid())
  instrument String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stance     String // bullish | neutral | bearish
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([instrument, userId])
  @@index([instrument, updatedAt])
}

// Hourly snapshot of the aggregate, for the sentiment history.
model SentimentSnapshot {
  id         String   @id @default(cuid())
  instrument String
  bucket     DateTime
  bullish    Int
  neutral    Int
  bearish    Int

  @@unique([instrument, bucket])
}

// Scheduled releases and decisions. Synced from the publishers' official
// calendars; admins can add events and fill in previous/forecast/actual.
model MarketEvent {
  id              String        @id @default(cuid())
  sourceKey       String        @unique
  source          String // fomc | ecb | bls | bea | eurostat | admin
  title           String
  currency        String
  country         String
  category        String
  importance      String
  scheduledAt     DateTime
  dateOnly        Boolean       @default(false)
  referencePeriod String?
  previous        String?
  forecast        String?
  actual          String?
  valuesNote      String?
  sourceName      String?
  sourceUrl       String?
  instruments     String[]
  cancelled       Boolean       @default(false)
  summary         Json?
  summaryAt       DateTime?
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  conversation    Conversation?

  @@index([scheduledAt])
  @@index([currency, scheduledAt])
}

// Market-relevant news only: wire stories and official press releases that
// match a supported market. Anything unrelated is not stored.
model NewsItem {
  id               String    @id @default(cuid())
  source           String // finnhub | fed | ecb
  provider         String
  externalId       String    @unique
  headline         String
  summary          String?
  url              String
  imageUrl         String?
  publishedAt      DateTime
  currencies       String[]
  instruments      String[]
  topics           String[]
  official         Boolean   @default(false)
  explanation      Json?
  explanationModel String?
  explainedAt      DateTime?
  commentCount     Int       @default(0)
  createdAt        DateTime  @default(now())
  posts            Post[]

  @@index([publishedAt])
  @@index([headline(ops: raw("gin_trgm_ops"))], type: Gin, map: "NewsItem_headline_trgm")
}

// Follow a trader, market, topic, trade idea or event.
model Follow {
  id         String   @id @default(cuid())
  followerId String
  follower   User     @relation(fields: [followerId], references: [id], onDelete: Cascade)
  targetType String // user | market | topic | idea | event
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([followerId, targetType, targetId])
  @@index([targetType, targetId])
}

model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType  String // post | idea | news | message | event | conversation
  itemId    String
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
  @@index([userId, createdAt])
}

// Persistent notifications. groupKey batches repeats (e.g. reactions on one
// post) into a single unread row with a count.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  actorId   String?
  title     String
  body      String?
  link      String?
  data      Json      @default("{}")
  groupKey  String?
  count     Int       @default(1)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, readAt, updatedAt])
  @@index([userId, groupKey])
}

// A browser/device that accepted Web Push for a user. Removed when the push
// service reports it gone (404/410) or the user turns push off there.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model Report {
  id           String    @id @default(cuid())
  reporterId   String?
  reporter     User?     @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  targetType   String // post | comment | message | user | conversation
  targetId     String
  targetUserId String?
  category     String // spam | scam | harassment | hate | impersonation | fraud | manipulation | illegal | other
  details      String?
  auto         Boolean   @default(false)
  status       String    @default("open") // open | actioned | dismissed
  resolvedById String?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ModerationAction {
  id           String   @id @default(cuid())
  moderatorId  String?
  action       String // remove | restore | mute | unmute | suspend | ban | dismiss | warn
  targetType   String
  targetId     String
  targetUserId String?
  reportId     String?
  reason       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId, createdAt])
}

// block: no DMs either way, their content hidden. mute: their content hidden.
model UserRelation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("relationOwner", fields: [userId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("relationTarget", fields: [targetId], references: [id], onDelete: Cascade)
  kind      String // block | mute
  createdAt DateTime @default(now())

  @@unique([userId, targetId, kind])
  @@index([targetId, kind])
}

// Append-only event log that powers real-time delivery across serverless
// instances (each instance tails it and fans out to its open streams).
// Pruned after a few hours.
model RealtimeEvent {
  id        BigInt   @id @default(autoincrement())
  channel   String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}
