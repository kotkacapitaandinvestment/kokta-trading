generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  trader
  premium
  moderator
  admin
  super_admin
}

enum UserStatus {
  active
  suspended
  banned
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  initials     String
  role         Role       @default(trader)
  plan         String     @default("Free")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  lastLoginAt  DateTime?

  journalEntries    JournalEntry[]
  checklistDays     ChecklistDay[]
  settings          UserSettings?
  aiUsageLogs       AIUsageLog[]
  simulatorSessions SimulatorSession[]
  aiConversations   AIConversation[]
  kyc               KycProfile?

  // Community profile. username is chosen on first visit to Community.
  username            String?   @unique
  headline            String?
  bio                 String?
  avatarId            String?
  lastSeenAt          DateTime?
  communityMutedUntil DateTime?

  // Security. Sessions issued before sessionsValidAfter are rejected (set on
  // password change and "sign out everywhere"). Two-step verification (TOTP)
  // is optional; the secret is encrypted and recovery codes are stored hashed.
  sessionsValidAfter DateTime?
  mfaSecretCipher    String?
  mfaEnabledAt       DateTime?
  mfaRecoveryHashes  String[]  @default([])
  mfaLastUsedStep    Int?

  // Email: confirmed address, and the newsletter choice (opt-in only).
  // newsletterContactId is the contact's id in the INBOX list.
  emailVerifiedAt     DateTime?
  newsletterOptIn     Boolean   @default(false)
  newsletterOptInAt   DateTime?
  newsletterContactId String?

  media             Media[]
  memberships       ConversationMember[]
  messages          Message[]
  messageReactions  MessageReaction[]
  posts             Post[]
  comments          Comment[]
  postReactions     PostReaction[]
  pollVotes         PollVote[]
  sentimentVotes    SentimentVote[]
  follows           Follow[]
  savedItems        SavedItem[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  sessions          Session[]
  emailTokens       EmailToken[]
  goals             Goal[]
  goalCheckIns      GoalCheckIn[]
  achievements      Achievement[]
  achievementShares AchievementShare[]
  reports           Report[]
  relations         UserRelation[]       @relation("relationOwner")
  relatedBy         UserRelation[]       @relation("relationTarget")
  usageRecords      UsageRecord[]
  usageOverrides    UsageOverride[]
  usageResets       UsageReset[]
  wallet            Wallet?
  deposits          Deposit[]
  withdrawals       Withdrawal[]
  payoutAccounts    PayoutAccount[]
  gamePlayers       GamePlayer[]
  gameProfile       GameProfile?
  gameBadges        GameBadge[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_name_trgm")
}

model JournalEntry {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              String
  market            String
  session           String
  strategy          String
  direction         String
  entry             Float
  stopLoss          Float
  takeProfit        Float
  risk              Float
  reward            Float
  result            String?
  pnl               Float?
  emotionBefore     String
  emotionAfter      String?
  confidence        Int
  mistakes          String    @default("")
  lessons           String    @default("")
  checklistComplete Boolean   @default(false)
  positionStatus    String    @default("closed")
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  // Kotka AI review, generated on request and kept with the entry.
  aiReview          String?
  aiReviewModel     String?
  aiReviewAt        DateTime?

  @@index([userId])
}

model ChecklistDay {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String
  items  Json   @default("{}")

  @@unique([userId, date])
}

model UserSettings {
  id                   String @id @default(cuid())
  userId               String @unique
  user                 User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications        Json   @default("{\"checklist\": true, \"journal\": true, \"riskWarnings\": true, \"weeklyReview\": true, \"aiInsights\": false}")
  aiPreferences        Json   @default("{\"tone\": \"Direct & challenging\", \"autoSuggest\": true, \"rememberContext\": true}")
  tradingPreferences   Json   @default("{\"baseCurrency\": \"USD\", \"dailyLossLimit\": 2, \"defaultRisk\": 1}")
  // Community notification switches and privacy (online status, read
  // receipts, who may message you). Missing keys use the defaults in code.
  communityPreferences Json   @default("{}")
  // Goal Room: { autoPost, showOnProfile }. Missing keys use code defaults.
  goalRoomPreferences  Json   @default("{}")
}

model Integration {
  id           String   @id @default(cuid())
  provider     String   @unique
  secretCipher String?
  publicKey    String?
  config       Json     @default("{}")
  enabled      Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model ContentItem {
  id        String   @id @default(cuid())
  title     String
  type      String
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id        String   @id @default(cuid())
  title     String
  lessons   Int      @default(0)
  enrolled  Int      @default(0)
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String?
  audience    String    @default("All users")
  status      String    @default("draft")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model MarketNewsItem {
  id          String   @id @default(cuid())
  headline    String
  market      String
  impact      String   @default("medium")
  publishedAt DateTime @default(now())
}

// Legacy: Kotka AI's first usage log. Its rows were copied into UsageRecord on
// 2026-09-28 and nothing writes here any more. Kept, not dropped.
model AIUsageLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String
  model     String
  latencyMs Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ── Usage control (server/src/lib/usage/) ────────────────────────────────────
// Everyone is on the same free configuration today. Limits carry a scope
// ("default") so plan-specific limits can be added later without changing the
// engine.

// Daily / weekly / monthly limits for a meter: a whole feature ("kotka_ai")
// or one action in it ("kotka_ai.chart_analysis"). null = no limit for that
// period. enabled=false keeps counting but stops enforcing.
model UsageLimit {
  id        String   @id @default(cuid())
  scope     String   @default("default")
  meter     String
  daily     Int?
  weekly    Int?
  monthly   Int?
  enabled   Boolean  @default(true)
  warnAtPct Int      @default(80)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([scope, meter])
}

// Emergency switch per feature. Paused features refuse new work with a
// "temporarily unavailable" message (not a limit message).
model FeatureControl {
  feature   String   @id
  enabled   Boolean  @default(true)
  note      String?
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// The usage ledger. One row per metered operation. Rows are never deleted by
// Kotka (admin resets add a UsageReset instead); they go only when the
// account is deleted.
//   pending   reserved, work in progress (counts)
//   consumed  the work happened (counts)
//   abandoned a reservation that was never settled (counts, so an
//             interrupted request is never free)
//   released  nothing costly happened, e.g. answered from cache (not counted)
//   failed    the provider or Kotka failed (not counted)
//   blocked   a refused attempt over a limit (0 units, for analytics)
model UsageRecord {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature       String
  action        String
  units         Int       @default(1)
  status        String
  requestKey    String?
  provider      String?
  model         String?
  inputTokens   Int?
  outputTokens  Int?
  totalTokens   Int?
  estimatedCost Decimal?  @db.Decimal(12, 6)
  latencyMs     Int?
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())
  settledAt     DateTime?

  @@unique([userId, requestKey])
  @@index([userId, feature, createdAt])
  @@index([feature, createdAt])
  @@index([createdAt])
}

// A different limit for one person (testers, staff, ambassadors). Replaces
// the default limits for that meter while active. null = no limit.
model UsageOverride {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  meter     String
  daily     Int?
  weekly    Int?
  monthly   Int?
  startsAt  DateTime  @default(now())
  expiresAt DateTime?
  endedAt   DateTime?
  reason    String
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, meter])
}

// An admin reset of one person's usage for a feature. Counting for that
// period starts again from createdAt; the ledger is untouched. A week reset
// also resets the day; a month reset resets all three.
model UsageReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   String
  period    String // day | week | month
  reason    String?
  createdBy String
  createdAt DateTime @default(now())

  @@index([userId, feature, createdAt])
}

// Legacy: the Simulator feature was removed on 2026-09-26. These tables and
// their data are intentionally kept (owner's decision) — do not drop them.
model SimulatorSession {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol              String
  ticker              String
  timeframeMultiplier Int
  timeframeUnit       String
  windowStart         DateTime
  windowEnd           DateTime
  bars                Json
  cursor              Int       @default(0)
  startingBalance     Float     @default(10000)
  balance             Float
  status              String    @default("active")
  createdAt           DateTime  @default(now())
  completedAt         DateTime?

  trades SimulatorTrade[]

  @@index([userId])
  @@index([createdAt])
}

model SimulatorTrade {
  id            String           @id @default(cuid())
  sessionId     String
  session       SimulatorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  direction     String
  size          Float
  entryPrice    Float
  entryBarIndex Int
  entryAt       DateTime
  stopLoss      Float?
  takeProfit    Float?
  exitPrice     Float?
  exitBarIndex  Int?
  exitAt        DateTime?
  pnl           Float?
  result        String?
  closeReason   String?
  status        String           @default("open")
  createdAt     DateTime         @default(now())

  @@index([sessionId])
}

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @default("New analysis")
  market    String      @default("Forex")
  favorite  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AIMessage[]

  @@index([userId])
  @@index([updatedAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  image          String?
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

// ── Kotka Fundamental Research ────────────────────────────────────────────
// Admin-controlled configuration (singleton row, id = "singleton").
model ResearchSettings {
  id        String   @id @default("singleton")
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Raw upstream responses (IMF, ECB, FRED, BIS, calendars...) cached server-side
// so repeated research runs don't re-hit every source.
model ResearchSourceCache {
  key       String   @id
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// Every completed research report is kept — the history is the fundamental trend.
model ResearchReport {
  id              String   @id @default(cuid())
  kind            String // "currency" | "pair"
  subject         String // "EUR" | "EURUSD"
  score           Int?
  confidence      Int?
  condition       String?
  direction       String?
  payload         Json
  narrativeSource String   @default("rules") // "rules" | "ai"
  model           String?
  durationMs      Int?
  createdAt       DateTime @default(now())

  @@index([kind, subject, createdAt])
}

model ResearchRun {
  id           String    @id @default(cuid())
  kind         String
  subject      String
  trigger      String // "user" | "admin" | "cron"
  userId       String?
  status       String    @default("running") // running | succeeded | failed
  error        String?
  sourceStatus Json      @default("[]")
  reportId     String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([subject, startedAt])
  @@index([userId, startedAt])
}

// Institutional assessments with no machine-readable API (e.g. IMF External
// Sector Report valuations), entered by an admin with the original source.
model SourceAssessment {
  id             String   @id @default(cuid())
  currency       String
  factor         String
  institution    String
  title          String
  classification String?
  statement      String
  url            String
  publishedAt    DateTime
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([currency, factor])
}

// ── Platform ──────────────────────────────────────────────────────────────
// Platform-wide switches (paid plans, sign-ups, KYC, AI fair use). Singleton.
model AppSettings {
  id        String   @id @default("singleton")
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Identity verification. Personal details are stored AES-256-GCM encrypted
// (detailsCipher); only country and review state are kept in the clear.
model KycProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  detailsCipher String
  country       String
  status        String    @default("pending") // pending | approved | rejected
  reviewNote    String?
  reviewedById  String?
  reviewedAt    DateTime?
  submittedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, submittedAt])
}

// Record of administrative and security-relevant actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  detail     Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}

// Sign-in / sign-up attempts, used for rate limiting.
// One row per signed-in browser. The session cookie carries this id (signed);
// revoking the row signs that browser out.
model Session {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  device     String?

  @@index([userId])
}

// Single-use links sent by email (password reset, email confirmation).
// Only a SHA-256 hash of the token is stored.
model EmailToken {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String // reset | verify
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

// Sliding-window rate limits shared by every server instance.
model RateLimitHit {
  id        BigInt   @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model AuthAttempt {
  id        String   @id @default(cuid())
  kind      String // login | signup
  email     String?
  ip        String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([kind, email, createdAt])
  @@index([kind, ip, createdAt])
}

// ══ Community ═══════════════════════════════════════════════════════════════

// Uploaded images and voice notes. Kept in Postgres (no file store is set up);
// clients compress before upload. Served only to signed-in users, by id+token.
model Media {
  id         String   @id @default(cuid())
  token      String
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind       String // image | audio
  mime       String
  size       Int
  width      Int?
  height     Int?
  durationMs Int?
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([ownerId, createdAt])
}

// One model for every place people talk: direct messages, private groups,
// public/private communities, market rooms and event rooms.
model Conversation {
  id            String       @id @default(cuid())
  kind          String // dm | group | community | room | event
  visibility    String       @default("private") // public | private | invite_only
  slug          String?      @unique
  name          String?
  description   String?
  imageId       String?
  instrument    String? // market rooms
  eventId       String?      @unique
  event         MarketEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sendPolicy    String       @default("everyone") // everyone | admins
  joinPolicy    String       @default("open") // open | approval | invite
  inviteCode    String?      @unique
  dmKey         String?      @unique // "<userA>:<userB>" sorted, for one-to-one chats
  createdById   String?
  featured      Boolean      @default(false)
  archivedAt    DateTime?
  lastMessageAt DateTime?
  messageCount  Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([kind, lastMessageAt])
  @@index([instrument])
}

model ConversationMember {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            String       @default("member") // owner | admin | moderator | member
  status          String       @default("active") // active | pending | left | removed
  mutedUntil      DateTime?
  archivedAt      DateTime?
  lastReadAt      DateTime?
  lastDeliveredAt DateTime?
  joinedAt        DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, status])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind           String       @default("text") // text | system
  body           String       @default("")
  // [{ type: image|audio|market|idea|post|news|event|poll, ... }]
  attachments    Json         @default("[]")
  mentions       String[]
  flags          String[] // safety flags raised when the message was sent
  replyToId      String?
  replyTo        Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReply")
  threadRootId   String?
  threadCount    Int          @default(0)
  lastThreadAt   DateTime?
  editedAt       DateTime?
  deletedAt      DateTime?
  removedById    String?
  pinnedAt       DateTime?
  pinnedById     String?
  createdAt      DateTime     @default(now())

  reactions MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([threadRootId, createdAt])
  @@index([authorId, createdAt])
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "Message_body_trgm")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

model Post {
  id            String    @id @default(cuid())
  authorId      String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind          String // post | market | idea | poll | question | news
  body          String    @default("")
  instrument    String?
  topics        String[]
  attachments   Json      @default("[]")
  newsId        String?
  news          NewsItem? @relation(fields: [newsId], references: [id], onDelete: SetNull)
  mentions      String[]
  flags         String[]
  commentCount  Int       @default(0)
  reactionCount Int       @default(0)
  featuredAt    DateTime?
  editedAt      DateTime?
  deletedAt     DateTime?
  removedById   String?
  removedAt     DateTime?
  createdAt     DateTime  @default(now())

  idea      TradeIdea?
  poll      Poll?
  reactions PostReaction[]

  @@index([createdAt])
  @@index([instrument, createdAt])
  @@index([authorId, createdAt])
  @@index([kind, createdAt])
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "Post_body_trgm")
}

// Structured market thesis. Never called a signal.
model TradeIdea {
  id              String    @id @default(cuid())
  postId          String    @unique
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  instrument      String
  direction       String // bullish | bearish
  timeframe       String
  entry           Float
  stop            Float
  target          Float
  riskReward      Float?
  thesis          String
  status          String    @default("open") // open | updated | closed | invalidated
  statusNote      String?
  statusChangedAt DateTime?
  history         Json      @default("[]")
  createdAt       DateTime  @default(now())

  @@index([instrument, status])
}

// Comments on posts, trade ideas and news items. A comment with a
// challengeCategory is a structured "Challenge thesis".
model Comment {
  id                String    @id @default(cuid())
  targetType        String // post | news
  targetId          String
  authorId          String
  author            User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId          String?
  body              String
  challengeCategory String? // technical | fundamental | risk | timing | liquidity | invalidation
  mentions          String[]
  flags             String[]
  editedAt          DateTime?
  deletedAt         DateTime?
  removedById       String?
  createdAt         DateTime  @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([authorId, createdAt])
}

model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String   @default("like")
  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
}

// A poll belongs to a post or to a chat message.
model Poll {
  id        String       @id @default(cuid())
  postId    String?      @unique
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  messageId String?      @unique
  question  String
  closesAt  DateTime?
  createdAt DateTime     @default(now())
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label     String
  position  Int
  voteCount Int        @default(0)
  votes     PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([pollId, userId])
}

// Each trader's current view on an instrument; changeable any time.
model SentimentVote {
  id         String   @id @default(cuid())
  instrument String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stance     String // bullish | neutral | bearish
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([instrument, userId])
  @@index([instrument, updatedAt])
}

// Hourly snapshot of the aggregate, for the sentiment history.
model SentimentSnapshot {
  id         String   @id @default(cuid())
  instrument String
  bucket     DateTime
  bullish    Int
  neutral    Int
  bearish    Int

  @@unique([instrument, bucket])
}

// Scheduled releases and decisions. Synced from the publishers' official
// calendars; admins can add events and fill in previous/forecast/actual.
model MarketEvent {
  id              String        @id @default(cuid())
  sourceKey       String        @unique
  source          String // fomc | ecb | bls | bea | eurostat | admin
  title           String
  currency        String
  country         String
  category        String
  importance      String
  scheduledAt     DateTime
  dateOnly        Boolean       @default(false)
  referencePeriod String?
  previous        String?
  forecast        String?
  actual          String?
  valuesNote      String?
  sourceName      String?
  sourceUrl       String?
  instruments     String[]
  cancelled       Boolean       @default(false)
  summary         Json?
  summaryAt       DateTime?
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  conversation    Conversation?

  @@index([scheduledAt])
  @@index([currency, scheduledAt])
}

// Market-relevant news only: wire stories and official press releases that
// match a supported market. Anything unrelated is not stored.
model NewsItem {
  id               String    @id @default(cuid())
  source           String // finnhub | fed | ecb
  provider         String
  externalId       String    @unique
  headline         String
  summary          String?
  url              String
  imageUrl         String?
  publishedAt      DateTime
  currencies       String[]
  instruments      String[]
  topics           String[]
  official         Boolean   @default(false)
  explanation      Json?
  explanationModel String?
  explainedAt      DateTime?
  commentCount     Int       @default(0)
  createdAt        DateTime  @default(now())
  posts            Post[]

  @@index([publishedAt])
  @@index([headline(ops: raw("gin_trgm_ops"))], type: Gin, map: "NewsItem_headline_trgm")
}

// Follow a trader, market, topic, trade idea or event.
model Follow {
  id         String   @id @default(cuid())
  followerId String
  follower   User     @relation(fields: [followerId], references: [id], onDelete: Cascade)
  targetType String // user | market | topic | idea | event
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([followerId, targetType, targetId])
  @@index([targetType, targetId])
}

model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType  String // post | idea | news | message | event | conversation
  itemId    String
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
  @@index([userId, createdAt])
}

// Persistent notifications. groupKey batches repeats (e.g. reactions on one
// post) into a single unread row with a count.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  actorId   String?
  title     String
  body      String?
  link      String?
  data      Json      @default("{}")
  groupKey  String?
  count     Int       @default(1)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, readAt, updatedAt])
  @@index([userId, groupKey])
}

// A browser/device that accepted Web Push for a user. Removed when the push
// service reports it gone (404/410) or the user turns push off there.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// ── Goal Room ─────────────────────────────────────────────────────────────
// Goals a trader sets and locks, daily check-ins, earned achievements and the
// public share links made from them. Everything is self-reported until a
// broker integration can verify it (verification stays 'self_reported').

model Goal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric       String // checkins | disciplined_days | streak | learning | backtests | journal_trades | net_profit
  title        String
  why          String?
  target       Float
  periodDays   Int
  startDate    String // YYYY-MM-DD, trader's local calendar
  endDate      String // inclusive
  status       String    @default("draft") // draft | active | achieved | completed | missed | abandoned
  lockedAt     DateTime?
  achievedAt   DateTime?
  closedAt     DateTime?
  verification String    @default("self_reported")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, status])
}

model GoalCheckIn {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             String // trader's local date, YYYY-MM-DD
  traded           Boolean
  planFollowed     Boolean?
  riskRespected    Boolean?
  noRevengeTrading Boolean?
  learning         Int      @default(0)
  backtests        Int      @default(0)
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, date])
}

model Achievement {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // goal_created | goal_locked | goal_reached | goal_completed | streak | discipline_streak | badge | checkins | learning | backtests | monthly_review | monthly_champion | most_improved
  key          String // de-duplicates: one achievement per key per trader
  goalId       String?
  title        String
  data         Json     @default("{}") // facts as they were when earned
  earnedAt     DateTime @default(now())
  verification String   @default("self_reported")
  pinned       Boolean  @default(false)
  postId       String?

  @@unique([userId, key])
  @@index([userId, earnedAt])
  @@index([type, earnedAt])
}

// A public link to a share card. snapshot holds exactly what the public page
// may show (the fields the trader chose), nothing more.
model AchievementShare {
  id        String    @id @default(cuid())
  slug      String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String // achievement | checkin | monthly | journey
  sourceId  String
  fields    String[]
  snapshot  Json
  imageId   String?
  views     Int       @default(0)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Report {
  id           String    @id @default(cuid())
  reporterId   String?
  reporter     User?     @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  targetType   String // post | comment | message | user | conversation
  targetId     String
  targetUserId String?
  category     String // spam | scam | harassment | hate | impersonation | fraud | manipulation | illegal | other
  details      String?
  auto         Boolean   @default(false)
  status       String    @default("open") // open | actioned | dismissed
  resolvedById String?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ModerationAction {
  id           String   @id @default(cuid())
  moderatorId  String?
  action       String // remove | restore | mute | unmute | suspend | ban | dismiss | warn
  targetType   String
  targetId     String
  targetUserId String?
  reportId     String?
  reason       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId, createdAt])
}

// block: no DMs either way, their content hidden. mute: their content hidden.
model UserRelation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("relationOwner", fields: [userId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("relationTarget", fields: [targetId], references: [id], onDelete: Cascade)
  kind      String // block | mute
  createdAt DateTime @default(now())

  @@unique([userId, targetId, kind])
  @@index([targetId, kind])
}

// Append-only event log that powers real-time delivery across serverless
// instances (each instance tails it and fans out to its open streams).
// Pruned after a few hours.
model RealtimeEvent {
  id        BigInt   @id @default(autoincrement())
  channel   String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── Trading Game (server/src/lib/game/) ─────────────────────────────────────
// Three money systems that never mix:
//   1. Naira: real money moving through Whop or Paystack (Deposit, Withdrawal).
//   2. Kotka Credits: the wallet balance, 1 credit = ₦1, held in kobo
//      (Wallet, WalletEntry). Only cash credits can be withdrawn.
//   3. Virtual trading capital: game-only numbers inside a match (GamePlayer),
//      never stored in a wallet and never convertible.

model GameSettings {
  id        String   @id @default("singleton")
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// One wallet per person, plus one "house" wallet that receives platform
// fees. Balances are kobo. They change only inside a transaction that also
// writes a WalletEntry, with the row locked (SELECT ... FOR UPDATE).
model Wallet {
  id                  String        @id @default(cuid())
  kind                String        @default("user") // user | house
  userId              String?       @unique
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  availableKobo       BigInt        @default(0)
  lockedKobo          BigInt        @default(0) // stakes in live competitions
  pendingWithdrawKobo BigInt        @default(0) // requested withdrawals not yet paid
  promoAvailableKobo  BigInt        @default(0) // promotional credits: never withdrawable
  promoLockedKobo     BigInt        @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  entries             WalletEntry[]
}

// The immutable ledger. Rows are only ever inserted. idempotencyKey makes a
// money movement happen at most once (a replayed webhook, a double settle).
model WalletEntry {
  id              String   @id @default(cuid())
  walletId        String
  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  userId          String?
  type            String // deposit | stake_lock | stake_release | stake_debit | winnings | draw_return | refund | fee | withdrawal_hold | withdrawal_release | withdrawal_paid | adjustment | promo_credit
  creditType      String   @default("cash") // cash | promo
  amountKobo      BigInt // always positive; the deltas give the direction
  availableDelta  BigInt   @default(0)
  lockedDelta     BigInt   @default(0)
  pendingDelta    BigInt   @default(0)
  availableBefore BigInt
  availableAfter  BigInt
  lockedBefore    BigInt
  lockedAfter     BigInt
  pendingBefore   BigInt
  pendingAfter    BigInt
  currency        String   @default("NGN")
  status          String   @default("completed")
  matchId         String?
  depositId       String?
  withdrawalId    String?
  reason          String?
  idempotencyKey  String   @unique
  createdBy       String?
  createdAt       DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([matchId])
  @@index([type, createdAt])
}

model Deposit {
  id                String    @id @default(cuid())
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider          String // whop | paystack
  amountKobo        BigInt
  currency          String    @default("NGN")
  status            String    @default("initiated") // initiated | succeeded | failed | expired
  providerRef       String? // Whop checkout configuration id / Paystack reference
  providerPaymentId String? // Whop pay_… / Paystack transaction id
  checkoutUrl       String?
  failureReason     String?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  @@unique([provider, providerRef])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Withdrawal {
  id              String    @id @default(cuid())
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider        String
  amountKobo      BigInt
  currency        String    @default("NGN")
  status          String    @default("requested") // requested | processing | paid | failed | rejected | cancelled
  payoutAccountId String?
  providerRef     String?
  failureReason   String?
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Where a person's withdrawals go: a Whop connected account (they finish
// identity checks and choose a bank on Whop), or a Paystack bank recipient.
model PayoutAccount {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String
  externalId    String // Whop biz_… / Paystack RCP_…
  bankName      String?
  accountLast4  String?
  accountName   String?
  nameMatchesId Boolean?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, provider])
}

// Each webhook delivery is handled once (providers deliver at least once).
model PaymentWebhookEvent {
  id          String    @id // provider:eventId
  provider    String
  type        String
  status      String    @default("received") // received | processed | ignored | failed
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

// A competition (or a solo practice run). The market is regenerated from
// scenario + seed + generatorVersion whenever it's needed; marketHash proves
// it is the same path at settlement.
model GameMatch {
  id               String                @id @default(cuid())
  code             String                @unique
  mode             String                @default("duel") // duel | practice
  status           String // CREATED | WAITING_FOR_OPPONENT | READY | LOCKED | COUNTDOWN | ACTIVE | COMPLETED | SCORING | SETTLEMENT | SETTLED | CANCELLED | EXPIRED | ABANDONED | DISPUTED | REFUNDED
  scenario         String
  scenarioCode     String
  seed             Int
  generatorVersion Int
  marketHash       String
  durationSec      Int
  candleSec        Int
  historyCandles   Int
  speed            Float                 @default(1)
  startingCapital  Int
  stakeKobo        BigInt                @default(0)
  feeBps           Int                   @default(0)
  rules            Json                  @default("{}")
  creatorId        String
  invitedUserId    String?
  isOpen           Boolean               @default(false)
  rematchOfId      String?
  expiresAt        DateTime?
  readyBy          DateTime?
  startsAt         DateTime?
  endsAt           DateTime?
  settledAt        DateTime?
  result           Json?
  flags            Json                  @default("[]")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  players          GamePlayer[]
  actions          GameAction[]
  transitions      GameMatchTransition[]

  @@index([status, createdAt])
  @@index([creatorId, createdAt])
  @@index([invitedUserId, status])
  @@index([isOpen, status])
}

model GamePlayer {
  id             String    @id @default(cuid())
  matchId        String
  match          GameMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  role           String // creator | opponent | solo
  confirmedAt    DateTime?
  lastSeenAt     DateTime?
  finalEquity    Float?
  returnPct      Float?
  maxDrawdownPct Float?
  score          Float?
  subscores      Json?
  report         Json?
  outcome        String? // win | loss | draw | refund | practice
  payoutKobo     BigInt    @default(0)
  xpAwarded      Int       @default(0)
  createdAt      DateTime  @default(now())

  @@unique([matchId, userId])
  @@index([userId, createdAt])
}

// Every decision a player sends, stamped with the server's tick. Fills from
// stops, targets and the end of the match are derived from these and the
// market, never sent by the client.
model GameAction {
  id         String    @id @default(cuid())
  matchId    String
  match      GameMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId     String
  seq        Int
  tick       Int
  type       String // open | increase | reduce | close | modify
  payload    Json
  requestKey String?
  clientTick Int?
  createdAt  DateTime  @default(now())

  @@unique([matchId, userId, seq])
  @@unique([matchId, userId, requestKey])
  @@index([matchId, tick])
}

model GameMatchTransition {
  id        String    @id @default(cuid())
  matchId   String
  match     GameMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  fromState String?
  toState   String
  actorId   String?
  reason    String?
  createdAt DateTime  @default(now())

  @@index([matchId, createdAt])
}

// Progression is separate from money: XP and levels measure play and learning.
model GameProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp        Int      @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt
}

model GameBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     String
  matchId   String?
  awardedAt DateTime @default(now())

  @@unique([userId, badge])
}
